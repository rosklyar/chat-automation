# Chat Automation Configuration

# Session directory (mounted as volume in Docker)
SESSIONS_DIR=/app/sessions

# API endpoints (use container name for Docker networking)
API_URL=http://prompts-backend:8000
RESULTS_API_URL=http://prompts-backend:8000

# API request parameters
ASSISTANT_NAME=ChatGPT
PLAN_NAME=Free

# Retry and polling configuration
MAX_ATTEMPTS=3
PER_SESSION_RUNS=10

# Polling backoff configuration
POLL_BASE_INTERVAL=5
POLL_MAX_INTERVAL=300
POLL_BACKOFF_MULTIPLIER=2.0
API_ERROR_RETRY_INTERVAL=300
BROWSER_CLOSE_THRESHOLD=60

# API authentication (required)
BOT_SECRET=your-secret-token-here
